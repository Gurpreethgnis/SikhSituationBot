# Mobile env — keep in sync with repo root `.env` (same values, Expo `EXPO_PUBLIC_*` names).
#
# Easiest: from repo root, copy `.env.example` → `.env` and fill values for web + Flask, then run:
#   cd mobile && npm run sync-env
# That writes `mobile/.env` from root `.env` (API URL, internal key, web Google client id).
#
# Manual copy (same numbers as web, different variable names):
#   NEXT_PUBLIC_API_URL          → EXPO_PUBLIC_API_URL (if "same-origin", sync uses FLASK_API_URL)
#   FLASK_INTERNAL_API_KEY       → EXPO_PUBLIC_FLASK_INTERNAL_KEY
#   GOOGLE_CLIENT_ID (Next web) → EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (also used as native fallback via clientId)
#
# Dev default: if EXPO_PUBLIC_API_URL is unset, the app uses http://localhost:5000 (same as client/lib/api.js).

# Flask API (required for production / TestFlight; optional in dev — defaults to localhost:5000)
EXPO_PUBLIC_API_URL=http://localhost:5000

# Same value as FLASK_INTERNAL_API_KEY in root `.env` (OAuth sync header X-Internal-Key)
EXPO_PUBLIC_FLASK_INTERNAL_KEY=

# Google Sign-In — Web client = Next.js GOOGLE_CLIENT_ID.
# For dev client / simulator / TestFlight / App Store you MUST add an iOS OAuth client (bundle com.gianiji.app)
# and set EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID — Web-only + auth.expo.io fails to return to the app.
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
