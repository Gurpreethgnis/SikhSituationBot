# Mobile environment variables
# Copy to .env.local and fill in your values

# ─── Flask Backend ───────────────────────────────────────────────────────────
# The base URL of your deployed Flask server (Railway)
EXPO_PUBLIC_API_URL=https://your-railway-flask-url.up.railway.app

# Internal key shared between Next.js/Expo and Flask for OAuth sync
# Must match FLASK_INTERNAL_API_KEY on the Flask server
EXPO_PUBLIC_FLASK_INTERNAL_KEY=your_internal_key_here

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# See mobile/README.md for step-by-step setup instructions.
#
# 1. Go to https://console.cloud.google.com/
# 2. Select your project (or create one)
# 3. Navigate to: APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#
# Expo Go client (used during development with Expo Go app)
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=your_expo_client_id.apps.googleusercontent.com

# iOS OAuth client (Application type: iOS, bundle ID: com.gianiji.app)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Android OAuth client (Application type: Android, package: com.gianiji.app)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# Web OAuth client (Application type: Web — same as used by the Next.js web app)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
