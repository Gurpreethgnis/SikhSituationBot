# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-project-id-here
GCP_LOCATION=us-central1

# Database Configuration (Railway PostgreSQL / Optional Local DB)
# For production: Railway provides DATABASE_URL automatically when a PostgreSQL template is linked.
# For local development: Set this to your local PostgreSQL instance or the remote Railway DB URL.
DATABASE_URL=postgresql://postgres:password@host:port/database

# Test database (used by pytest)
DATABASE_URL_TEST=sqlite:///:memory:

# API Keys
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
GEMINI_API_KEY=your-gemini-api-key
# Optional: admin-configurable /ask synthesis (also set keys for providers you enable in Admin → LLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Defaults used until the admin saves LLM settings (must match an option in server/llm_synthesis.py)
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=models/gemini-flash-latest

# Flask Config
FLASK_ENV="development"
PORT=5000

# Auth (Flask JWT for API; must match Next.js server-side calls)
JWT_SECRET=change-me-in-production
# First admin bootstrap: user with this email gets is_admin on register/oauth-sync
ADMIN_EMAIL=
# Shared secret for Next.js → Flask POST /api/auth/oauth-sync (header X-Internal-Key)
FLASK_INTERNAL_API_KEY=

# Share links in API responses (frontend /shared/{uuid})
# Production (Vercel frontend): set to your Vercel URL, e.g. https://your-app.vercel.app
# From repo root after `railway login` + `railway link`: VERCEL_URL=https://... ./scripts/railway-finish-env.sh
PUBLIC_APP_URL=http://localhost:3000

# Frontend (Vercel) — set in Vercel dashboard for production
NEXT_PUBLIC_API_URL=http://localhost:5000

# Next.js / NextAuth (set in client env or Vercel)
# --- Required for any sign-in (fixes "There is a problem with the server configuration") ---
# NEXTAUTH_SECRET: required in production. Generate: openssl rand -base64 32
# NEXTAUTH_URL: public site origin only, no trailing slash (e.g. https://your-app.vercel.app)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# --- Google OAuth (optional; omit both to hide "Continue with Google" and use email/password only) ---
# 1) Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID (Web application).
# 2) Authorized JavaScript origins: https://YOUR_DOMAIN  (and http://localhost:3000 for local)
# 3) Authorized redirect URIs: https://YOUR_DOMAIN/api/auth/callback/google
#    (and http://localhost:3000/api/auth/callback/google for local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same value as FLASK_INTERNAL_API_KEY above — Next.js sends it to Flask POST /api/auth/oauth-sync
# so Google users get a Flask JWT (chat/ask). Without it, Google sign-in completes but API calls fail.
# Optional: infer child/teen/adult from Google birthday — enable Google People API for your GCP project
# and ensure OAuth consent includes the birthday scope (see client/lib/authOptions.js).
# Server-side Flask base URL (same as NEXT_PUBLIC_API_URL unless split)
FLASK_API_URL=http://localhost:5000
